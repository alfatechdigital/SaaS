APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file


BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp (B-3). `log` sends nothing - it only writes to the application log, so
# a fresh clone or CI can never message a real person. Production sets `meta`.
# Per-tenant credentials live on `teams`, not here.
WHATSAPP_DRIVER=log
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_TIMEOUT=10
WHATSAPP_QUEUE=default

# WhatsApp webhook (B-3). Both values belong to the single Meta App every tenant
# connects its number to. Left empty, the webhook refuses every request instead of
# accepting unsigned traffic. Docs: phase-05-fitur-masa-depan.md B-3.2.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# WhatsApp abuse guards (B-3). Defaults are safe; change only when a tenant needs it.
WHATSAPP_RATE_LIMIT_PER_MINUTE=30
WHATSAPP_SERVICE_WINDOW_HOURS=24
WHATSAPP_ADDON_ALLOWANCE=500
WHATSAPP_TEMPLATE_LANGUAGE=id

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
